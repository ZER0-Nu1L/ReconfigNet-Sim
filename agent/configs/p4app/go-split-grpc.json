{
  "mode": "l3",
  "deployment_profile": "go-split-grpc",
  "model_file": "model-8port.yaml",
  "capability_profile_file": "capabilities.yaml",
  "enable_debugger": false,
  "grpc_api": {
    "host": "0.0.0.0",
    "port": 9339
  },
  "device": {
    "consistency_mode": "CACHED_SYNC"
  },
  "worker": {
    "target": "unix:///tmp/ocs-device-worker.sock",
    "timeout_seconds": 10
  },
  "startup_policy": "REAPPLY_DESIRED",
  "control": {
    "lease_seconds": 30,
    "reconcile_interval_seconds": 30
  },
  "go_agent": {
    "binary": "/usr/local/bin/ocs-go-agent"
  },
  "backend": {
    "type": "p4app"
  }
}
