{
  "name": "reconfignet-sim-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.22.2" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "node scripts/check-content.mjs && astro check && node --test tests/content.test.mjs",
    "build": "node scripts/check-content.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:build": "node --test tests/build.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "gray-matter": "4.0.3",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3"
  }
}
