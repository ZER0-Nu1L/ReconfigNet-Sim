---
import '../styles/site.css';
import 'katex/dist/katex.min.css';
import mark from '../../../docs/assets/branding/reconfignet-sim-mark-light.svg?url';
import darkMark from '../../../docs/assets/branding/reconfignet-sim-mark-dark.svg?url';
import { href, otherLanguage, repository, siteName, text, type Language } from '../lib/site';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  route?: string;
  noindex?: boolean;
  article?: boolean;
  date?: string;
  updated?: string;
  languageRoute?: string;
}
const { lang, title, description = text[lang].description, route = '', noindex = false, article = false, date, updated, languageRoute = noindex ? '' : route } = Astro.props;
const labels = text[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151b25" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const key = 'reconfignet-sim-theme';
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        let preference = null;
        try {
          const saved = localStorage.getItem(key);
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch { /* Storage can be disabled; switching still works for this page. */ }

        const applyTheme = (theme) => {
          document.documentElement.dataset.theme = theme;
          const button = document.querySelector('[data-theme-toggle]');
          if (button) {
            const label = theme === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
            button.setAttribute('aria-label', label);
            button.setAttribute('title', label);
            button.setAttribute('aria-pressed', String(theme === 'dark'));
          }
          document.querySelectorAll('meta[name="theme-color"]').forEach(meta => {
            meta.content = theme === 'dark' ? '#151b25' : '#fcfcfa';
          });
        };
        applyTheme(preference || (system.matches ? 'dark' : 'light'));
        system.addEventListener('change', event => {
          if (!preference) applyTheme(event.matches ? 'dark' : 'light');
        });
        document.addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector('[data-theme-toggle]');
          if (!button) return;
          applyTheme(document.documentElement.dataset.theme);
          button.hidden = false;
          button.addEventListener('click', () => {
            preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme(preference);
            try { localStorage.setItem(key, preference); } catch { /* Keep the in-memory choice. */ }
          });
        }, { once: true });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={mark} />
    {!noindex && <>
      <link rel="alternate" hreflang="en" href={new URL(href(`en/${route}`), Astro.site)} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(href(`zh/${route}`), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(href(`en/${route}`), Astro.site)} />
    </>}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (${lang})`} href={href(`${lang}/rss.xml`)} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {date && <meta property="article:published_time" content={`${date}T00:00:00Z`} />}
    {updated && <meta property="article:modified_time" content={`${updated}T00:00:00Z`} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <header class="site-header shell">
      <a class="brand" href={href(`${lang}/`)} aria-label={`${siteName} — ${labels.blog}`}>
        <img class="mark-light" src={mark} width="38" height="38" alt="" />
        <img class="mark-dark" src={darkMark} width="38" height="38" alt="" />
        <span>ReconfigNet<span class="brand-accent">-Sim</span><span class="brand-blog">Blog</span></span>
      </a>
      <nav aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
        <a href={href(`${lang}/`)} aria-current={route === '' && !noindex ? 'page' : undefined}>{labels.blog}</a>
        <a href={href(`${lang}/about/`)} aria-current={route === 'about/' ? 'page' : undefined}>{labels.about}</a>
        <a href={repository}>GitHub <span aria-hidden="true">↗</span></a>
        <a class="language-link" href={href(`${otherLanguage(lang)}/${languageRoute}`)} lang={otherLanguage(lang)} data-language-switch>{labels.language}</a>
        <button type="button" class="theme-toggle" data-theme-toggle data-label-light={labels.switchToLight} data-label-dark={labels.switchToDark} aria-label={labels.switchToDark} aria-pressed="false" hidden>
          <svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
          <svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
        </button>
      </nav>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><span class="footer-title">ReconfigNet-Sim</span><p>{labels.footer}</p></div>
      <a href={href(`${lang}/rss.xml`)}>RSS <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
