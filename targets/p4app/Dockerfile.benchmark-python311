FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends iproute2 iputils-ping && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      grpcio==1.75.1 \
      protobuf==3.20.3

WORKDIR /work
ENTRYPOINT ["python3", "benchmarks/protocol_latency.py"]
