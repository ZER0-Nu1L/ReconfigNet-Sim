FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends iproute2 iputils-ping && \
    rm -rf /var/lib/apt/lists/*

# Optional verified wheelhouse, useful for repeatable offline rehearsals.
ARG PIP_FIND_LINKS
ARG PIP_NO_INDEX

COPY agent/python/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN pip install --no-cache-dir -r /tmp/requirements-runtime.txt && \
    rm /tmp/requirements-runtime.txt

WORKDIR /work
ENTRYPOINT ["python3", "benchmarks/protocol_latency.py"]
