ARG AGENT_IMAGE=reconfig-net/ocs-p4app-agent:rc2
FROM ${AGENT_IMAGE}

# Optional verified wheelhouse, useful for repeatable offline rehearsals.
ARG PIP_FIND_LINKS
ARG PIP_NO_INDEX

COPY agent/python-legacy/requirements-runtime.txt agent/python-legacy/requirements-dev.txt /tmp/ocs-test-requirements/
RUN PYTHONPATH=/usr/local/lib/python3.5/dist-packages \
      python3 -S -m pip install --no-cache-dir \
      -r /tmp/ocs-test-requirements/requirements-dev.txt && \
    rm -rf /tmp/ocs-test-requirements
